<!DOCTYPE html>
<html>
<head>
    <title>Candidatos</title>
</head>

<body>

<h1>Lista de Candidatos</h1>

<a href="/candidatos/crear">
    Nuevo candidato
</a>

<br><br>

<table border="1">

    <thead>

        <tr>
            <th>CI</th>
            <th>Nombres</th>
            <th>Apellido 1</th>
            <th>Apellido 2</th>
            <th>Cargo</th>
            <th>Lugar</th>
            <th>Acciones</th>
        </tr>

    </thead>

    <tbody>

        <% candidatos.forEach(candidato => { %>

            <tr>

                <td>
                    <%= candidato.ci %>
                </td>

                <td>
                    <%= candidato.nombres %>
                </td>

                <td>
                    <%= candidato.apellido1 %>
                </td>

                <td>
                    <%= candidato.apellido2 %>
                </td>

                <td>
                    <%= candidato.cargo.nombre %>
                </td>

                <td>
                    <%= candidato.lugar.nombre %>
                </td>

                <td>

                    <a href="/candidatos/editar/<%= candidato.ci %>">
                        Editar
                    </a>

                    <form
                        action="/candidatos/<%= candidato.ci %>?_method=DELETE"
                        method="POST"
                        style="display:inline"
                    >

                        <button type="submit">
                            Eliminar
                        </button>

                    </form>

                </td>

            </tr>

        <% }) %>

    </tbody>

</table>

</body>
</html>